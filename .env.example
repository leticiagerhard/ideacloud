# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# NUNCA coloque estes valores no código nem faça commit do .env.local.

# Senha para entrar no app (escolha uma longa; trocar invalida os aparelhos já conectados)
APP_PASSWORD=

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave SECRETA (sb_secret_... ou "service_role" nas chaves legadas). Só no servidor!
SUPABASE_SECRET_KEY=
